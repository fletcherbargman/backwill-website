# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but .env.example holds no secrets and must be committed so anyone
# cloning this repo can see which variables are required
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
/_to_delete/
/_incoming/

# brand assets
# brand/ is committed, because the brand system should travel with the repo.
# Two exceptions: the large photographic frames below. Git cannot delta-compress
# PNGs, so every re-export would add a whole new copy to history permanently.
# Both re-export from Figma in under a minute, and brand/figma-system/colour-and-type.md
# holds every value that actually matters as plain text.
/brand/figma-system/Brand direction.png
/brand/figma-system/Frame 3.png

# Regenerable logo exports. Every one of these is a recolour of the three
# transparency masters in brand/source/masters/, which are committed. Sixteen
# large PNGs and eight tiles that git cannot delta-compress, for files that
# rebuild from the masters in minutes.
/brand/logo/png/
/brand/logo/tiles/
